{
  "name": "emi-ai-assistant",
  "version": "1.0.0",
  "description": "Frontend widget + admin SPA build pipeline for the Emi AI Assistant WordPress plugin.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "test": "jest",
    "test:e2e": "playwright test",
    "lint": "eslint assets/js"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "jest": "^29.7.0",
    "@playwright/test": "^1.45.0",
    "eslint": "^9.6.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/tests/js/**/*.test.js"
    ]
  }
}
